<Window x:Class="Win11StageManager.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11StageManager"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Width="200" Height="600">
    <Grid>
        <!-- Empty areas are fully transparent, so clicks there fall through to the desktop.
             Cards paint a near-invisible background so the whole card is clickable. -->
        <Canvas x:Name="Root" />

        <!-- Shown while an on-stage window is being dragged: release over it to send the window here. -->
        <Grid x:Name="DropZone" Visibility="Collapsed" Margin="8,12" IsHitTestVisible="False">
            <Rectangle x:Name="DropZoneFill" RadiusX="14" RadiusY="14"
                       Fill="#22FFFFFF" Stroke="#B3FFFFFF" StrokeThickness="2" StrokeDashArray="4 3" />
            <TextBlock Text="Drop here to move&#x0a;to the strip"
                       Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                       FontWeight="SemiBold" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
